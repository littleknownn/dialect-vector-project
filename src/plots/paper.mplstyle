# LLM-generated
font.family: serif
font.serif: Times New Roman, Times, Nimbus Roman, TeX Gyre Termes, DejaVu Serif
mathtext.fontset: stix
font.size: 9
axes.titlesize: 9
axes.labelsize: 9
xtick.labelsize: 8
ytick.labelsize: 8
legend.fontsize: 8
legend.frameon: False
axes.linewidth: 0.6
axes.spines.top: False
axes.spines.right: False
axes.titlepad: 4
lines.linewidth: 1.0
lines.markersize: 4
xtick.major.width: 0.6
ytick.major.width: 0.6
xtick.major.size: 3
ytick.major.size: 3
grid.linewidth: 0.4
grid.alpha: 0.3
errorbar.capsize: 0
axes.prop_cycle: cycler('color', ['0072B2', 'E69F00', '009E73', 'D55E00', 'CC79A7', '56B4E9', 'F0E442', '000000'])
figure.dpi: 150
savefig.dpi: 300
savefig.bbox: tight
savefig.pad_inches: 0.02
pdf.fonttype: 42
ps.fonttype: 42